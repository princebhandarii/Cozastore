# ---- Core (required from Phase 1 onward) ----
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# Atlas -> Database -> Connect -> Drivers -> copy the connection string,
# then replace <username>/<password>/<dbname>
MONGODB_URI=

# Only if you get "querySrv EBADRESP" when connecting to Atlas: development already uses
# public DNS (8.8.8.8, 1.1.1.1) by default. Override with a comma-separated list, or
# set DNS_SERVERS=system to use your machine's own resolver.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Firebase Admin SDK credentials
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# That JSON file gives you project_id, client_email and private_key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep this on one line; escape newlines as \n (the app un-escapes them).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Phase 2+ (not required yet, wired in later builds) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Phase 4 (required for online payments) ----
# Use Razorpay TEST keys while developing (Dashboard -> Account & Settings -> API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Phase 9: email ----
# EMAIL_PROVIDER=console (default when EMAIL_HOST is blank) prints emails in
# the server terminal instead of sending them, and refuses to run in
# production. Set EMAIL_PROVIDER=smtp + the fields below to send real email
# through any SMTP provider (Gmail app password, SendGrid, Mailgun, SES, ...).
EMAIL_PROVIDER=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Coza Store <no-reply@example.com>"

# ---- Phase 9: real courier integration (optional) ----
# Leave SHIPPING_PROVIDER=pincode-lookup (Phase 4 default) to keep the
# development-only manual shipping flow. Set it to "shiprocket" plus the
# fields below for real serviceability checks, shipment creation and AWB
# assignment through Shiprocket (https://apidocs.shiprocket.in).
# SHIPPING_PROVIDER=shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_PICKUP_LOCATION=Primary
# Shared secret Shiprocket sends back in a header on every webhook call -
# set the same value in Shiprocket's webhook settings.
SHIPROCKET_WEBHOOK_TOKEN=

# pincode-lookup = India Post PIN directory (verifies PIN/state/delivery post office).
SHIPPING_PROVIDER=pincode-lookup
FREE_SHIPPING_THRESHOLD=999
FLAT_SHIPPING_CHARGE=50

SHIPPING_API_URL=
SHIPPING_API_KEY=

# ---- Phase 5: COD phone OTP ----
# console = DEVELOPMENT ONLY: prints the OTP in the server terminal, sends no SMS,
#           and refuses to run when NODE_ENV=production.
# http    = generic JSON adapter (see server/services/otp/providers/http.js);
#           adapt it to your SMS vendor before using it for real.
SMS_PROVIDER=console
# Required in production: long random string used to hash OTPs.
OTP_SECRET=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Phase 7: invoice seller details ----
STORE_NAME=Coza Store
STORE_ADDRESS=
STORE_STATE=
STORE_GSTIN=
STORE_EMAIL=
STORE_PHONE=
# Prices are treated as GST-INCLUSIVE. 0 prints no tax lines. See README "Invoices".
GST_RATE_PERCENT=0
